<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2070D5"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#BAC4D1"/>
    <SolidColorBrush x:Key="TextBrush" Color="#253247"/>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="{StaticResource BackgroundBrush}"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="WindowStartupLocation" Value="CenterScreen"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="5,3"/><Setter Property="Margin" Value="0,2"/><Setter Property="MinHeight" Value="28"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="4,2"/><Setter Property="Margin" Value="0,2"/><Setter Property="MinHeight" Value="28"/></Style>
    <Style TargetType="DatePicker"><Setter Property="Margin" Value="0,2"/><Setter Property="MinHeight" Value="28"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="12,5"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Width" Value="96"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
</ResourceDictionary>
