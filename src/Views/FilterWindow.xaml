<Window x:Class="GMAnnotation.Views.FilterWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批注过滤 · 按内容"
        Width="680" Height="440"
        MinWidth="460" MinHeight="280"
        ResizeMode="CanResize"
        Topmost="True" ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary Source="../Themes/LATheme.xaml"/>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部说明 -->
        <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="CountText" Text="共 0 种内容" Style="{StaticResource StatusText}"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="按「批注内容完全一致」分组。选中一行后点「仅显示所选」（或双击该行）：图中只显示这一组批注，其余批注全部隐藏（数据不丢，只是不可见）。"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="「显示全部」会恢复全部批注的可见性（包括之前手动隐藏的）。"/>
            </StackPanel>
        </Border>

        <!-- 底部按钮 -->
        <Border DockPanel.Dock="Bottom" Padding="10,8" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="仅显示所选" MinWidth="96" Margin="0"
                        Style="{DynamicResource SecondaryButton}" Click="Apply_Click"/>
                <Button Grid.Column="1" Content="显示全部" MinWidth="80" Margin="8,0,0,0"
                        Style="{DynamicResource SecondaryButton}" Click="ShowAll_Click"/>
                <Button Grid.Column="2" Content="合并批注" MinWidth="104" Margin="8,0,0,0"
                        Style="{DynamicResource SecondaryButton}" Click="Merge_Click"
                        ToolTip="把当前图里内容完全相同的批注合并成一条（保留编号最小者，其余云线并入）"/>
                <Button Grid.Column="4" Content="刷新" MinWidth="64" Margin="0"
                        Style="{DynamicResource SecondaryButton}" Click="Refresh_Click"/>
                <Button Grid.Column="5" Content="关闭" MinWidth="64" Margin="8,0,0,0"
                        Style="{DynamicResource SecondaryButton}" Click="Close_Click"/>
            </Grid>
        </Border>

        <ListView x:Name="GroupList" SelectionMode="Single"
                  MouseDoubleClick="List_DoubleClick"
                  BorderThickness="0" Margin="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="条数" Width="52" DisplayMemberBinding="{Binding Count}"/>
                    <GridViewColumn Header="编号" Width="190" DisplayMemberBinding="{Binding Numbers}"/>
                    <GridViewColumn Header="批注内容（摘要）" Width="400" DisplayMemberBinding="{Binding Preview}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
