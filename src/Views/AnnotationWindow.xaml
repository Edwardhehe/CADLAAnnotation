<Window x:Class="LAAnnotation.Views.AnnotationWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LA批注" Width="500" Height="420"
        MinWidth="420" MinHeight="360"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary Source="../Themes/LATheme.xaml"/>
    </Window.Resources>

    <DockPanel>
        <!-- 底部按钮栏 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Content="创建批注" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/>
            </StackPanel>
        </Border>

        <!-- 表单区域 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 批注内容（占据更多高度） -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="批注内容" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ContentTextBox" Grid.Row="0" Grid.Column="1"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         MinHeight="120" Height="160"/>

                <!-- 专业 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="专业" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="DisciplineComboBox" Grid.Row="1" Grid.Column="1" IsEditable="True"/>

                <!-- 批注人 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="批注人" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="AuthorTextBox" Grid.Row="2" Grid.Column="1"/>

                <!-- 日期 -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="日期" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="AnnotationDatePicker" Grid.Row="3" Grid.Column="1"/>

                <!-- 状态 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="状态" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="StatusComboBox" Grid.Row="4" Grid.Column="1" IsEditable="True"/>

                <!-- 编号 -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="编号" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NumberTextBox" Grid.Row="5" Grid.Column="1"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
