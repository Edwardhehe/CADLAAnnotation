<Window x:Class="GMAnnotation.Views.AnnotationListPanel"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批注列表" Width="620" Height="420"
        MinWidth="400" MinHeight="260"
        ResizeMode="CanResize"
        Topmost="True" ShowInTaskbar="False"
        WindowStyle="ToolWindow" WindowStartupLocation="CenterScreen" Style="{DynamicResource GMWindow}">
    <Window.Resources>
        <ResourceDictionary Source="../Themes/LATheme.xaml"/>
    </Window.Resources>

    <DockPanel>
        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Padding="8,4,8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CountText" Grid.Column="0" Text="共 0 条" Style="{StaticResource StatusText}"/>
                <Button Grid.Column="1" Content="刷新" Style="{DynamicResource SecondaryButton}"
                        Click="Refresh_Click" Margin="0"/>
            </Grid>
        </Border>

        <ListView x:Name="AnnotationList" SelectionMode="Single"
                  MouseDoubleClick="List_DoubleClick"
                  AlternationCount="2" Margin="0">
            <!-- 状态着色：已完成=绿色（LA 提示绿 #239137）、已回复=黄色；选中行统一 #337AB7 白字 -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Status}" Value="已完成"/>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="#239137"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Status}" Value="已回复"/>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="#D19A00"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="删除" Click="Delete_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="编号" Width="78" DisplayMemberBinding="{Binding Number}"/>
                    <GridViewColumn Header="专业" Width="52" DisplayMemberBinding="{Binding Discipline}"/>
                    <GridViewColumn Header="状态" Width="58" DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="批注人" Width="64" DisplayMemberBinding="{Binding Author}"/>
                    <GridViewColumn Header="角色" Width="64" DisplayMemberBinding="{Binding Role}"/>
                    <GridViewColumn Header="日期" Width="88" DisplayMemberBinding="{Binding Date}"/>
                    <GridViewColumn Header="内容" Width="200" DisplayMemberBinding="{Binding Content}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
