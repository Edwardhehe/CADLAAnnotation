<Window x:Class="LAAnnotation.Views.AnnotationListPanel"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批注列表" Width="280" Height="500"
        MinWidth="220" MinHeight="300"
        ResizeMode="CanResize"
        Topmost="True" ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary Source="../Themes/LATheme.xaml"/>
    </Window.Resources>

    <DockPanel>
        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="CountText" Grid.Column="0" Text="共 0 条" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="刷新" Style="{DynamicResource SecondaryButton}" Click="Refresh_Click" Height="24" FontSize="11" Width="56"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListView x:Name="AnnotationList" SelectionMode="Single" BorderThickness="0"
                      MouseDoubleClick="List_DoubleClick" FontSize="12">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="  " FontSize="10"/>
                                    <TextBlock Text="{Binding Discipline}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Content}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxHeight="28" Margin="0,1,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
    </DockPanel>
</Window>
