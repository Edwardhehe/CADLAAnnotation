<Window x:Class="GMAnnotation.Views.AnnotationPanel"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GM 批注面板" Width="236" SizeToContent="Height"
        MinWidth="220"
        ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        WindowStyle="ToolWindow" Style="{DynamicResource GMWindow}">
    <Window.Resources>
        <ResourceDictionary Source="../Themes/LATheme.xaml"/>
    </Window.Resources>

    <!-- 精简面板：只选批注类型 / 形式；专业、批注人、外形、云线样式、角色、自动编号、双击编辑等
         使用已保存的设置，右下角「设置」打开完整设置窗口（同 GM_PZ_SETTINGS）。 -->
    <DockPanel Margin="8,8,8,8">
        <!-- 底部操作栏（同 LA 主窗口：主操作按钮 #0078D7） -->
        <Grid DockPanel.Dock="Bottom" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ContinuousCheck" Grid.Column="0" Content="连续批注" VerticalAlignment="Center" Margin="0"/>
            <Button Grid.Column="1" Content="设置" MinWidth="40" MinHeight="28" Margin="4,0,0,0"
                    Style="{StaticResource CompactButton}" Click="Settings_Click"
                    ToolTip="打开完整设置（同 GM_PZ_SETTINGS）：专业、批注人、外形、云线样式、角色、自动编号、双击编辑等"/>
            <Button x:Name="StartButton" Grid.Column="2" Content="开始批注" MinWidth="76"
                    Style="{DynamicResource AccentButton}" Click="Start_Click" Margin="4,0,0,0"/>
        </Grid>

        <StackPanel>
            <GroupBox Header="批注类型">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SingleModeRadio" Content="单独批注" IsChecked="True" GroupName="Mode"/>
                    <RadioButton x:Name="MultiModeRadio" Content="多对一批注" GroupName="Mode" Margin="0,2,0,2"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="批注形式">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ShapeRectRadio" Content="矩形" IsChecked="True" GroupName="Shape"/>
                        <RadioButton x:Name="ShapePlineRadio" Content="PL 线" GroupName="Shape"/>
                        <RadioButton x:Name="ShapeCircleRadio" Content="圆形" GroupName="Shape" Margin="0,2,0,2"/>
                    </StackPanel>
                    <CheckBox x:Name="CloudOnlyCheck" Content="仅绘云线（无文字/引线）" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </DockPanel>
</Window>
