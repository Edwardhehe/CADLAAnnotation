<Window x:Class="GMAnnotation.Views.AnnotationPanel"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GM 批注面板" Width="288" Height="420"
        MinWidth="268" MinHeight="360"
        ResizeMode="CanResize"
        Topmost="True" ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary Source="../Themes/LATheme.xaml"/>
    </Window.Resources>

    <DockPanel>
        <!-- 底部操作栏 -->
        <Border DockPanel.Dock="Bottom" Padding="10,8" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ContinuousCheck" Grid.Column="0" Content="连续批注" VerticalAlignment="Center"/>
                <Button x:Name="StartButton" Grid.Column="1" Content="开始批注"
                        Style="{DynamicResource PrimaryButton}" Click="Start_Click" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
            <StackPanel>
                <!-- 批注类型 -->
                <TextBlock Text="批注类型" Style="{StaticResource SectionHeader}" Margin="0,2,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton x:Name="SingleModeRadio" Content="单独批注" IsChecked="True" GroupName="Mode"/>
                    <RadioButton x:Name="MultiModeRadio" Content="多对一批注" GroupName="Mode" Margin="0,3,0,3"/>
                </StackPanel>

                <!-- 批注形式 -->
                <TextBlock Text="批注形式" Style="{StaticResource SectionHeader}" Margin="0,6,0,4"/>
                <UniformGrid Columns="2" Margin="0,0,0,4">
                    <RadioButton x:Name="ShapeRectRadio" Content="矩形" IsChecked="True" GroupName="Shape"/>
                    <RadioButton x:Name="ShapePlineRadio" Content="PL 线" GroupName="Shape"/>
                    <RadioButton x:Name="ShapeCircleRadio" Content="圆形" GroupName="Shape"/>
                </UniformGrid>

                <CheckBox x:Name="CloudOnlyCheck" Content="仅绘云线（无文字/引线）"/>

                <Rectangle Style="{StaticResource SectionSeparator}"/>

                <!-- 待应用设置 -->
                <TextBlock Text="批注设置（开始批注时生效）" Style="{StaticResource SectionHeader}" Margin="0,4,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="专业" Style="{StaticResource FieldLabelLeft}"/>
                    <ComboBox x:Name="DisciplineCombo" Grid.Row="0" Grid.Column="1" IsEditable="True"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="批注人" Style="{StaticResource FieldLabelLeft}"/>
                    <TextBox x:Name="AuthorText" Grid.Row="1" Grid.Column="1"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="外形" Style="{StaticResource FieldLabelLeft}"/>
                    <ComboBox x:Name="ShapeCombo" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="云线样式" Style="{StaticResource FieldLabelLeft}"/>
                    <ComboBox x:Name="CloudStyleCombo" Grid.Row="3" Grid.Column="1"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="角色" Style="{StaticResource FieldLabelLeft}"/>
                    <ComboBox x:Name="RoleCombo" Grid.Row="4" Grid.Column="1" IsEditable="True"/>
                </Grid>

                <CheckBox x:Name="AutoNumberCheck" Content="自动编号" Margin="0,6,0,0"/>
                <CheckBox x:Name="DoubleClickEditCheck" Content="双击编辑"/>

                <Button Content="完整设置…" Style="{StaticResource SecondaryButton}" Click="Settings_Click"
                        Margin="0,10,0,0" HorizontalAlignment="Right" MinWidth="88"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
